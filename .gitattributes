# Normalize line endings so rustfmt/prettier checks behave identically on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary

# Generated files: collapse in diffs.
pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock linguist-generated=true
ui/src/shared/ipc/bindings.ts linguist-generated=true
